import { Candle, MicrostructureFeatures, PriceActionFeatures, QuantScore } from '../models/strategy';
import { StrategyEngine, StrategyConfig } from '../strategy/StrategyEngine';
import { PriceActionEngine } from '../strategy/PriceActionEngine';
import { MicrostructureEngine } from '../strategy/MicrostructureEngine';
import { QuantEngine } from '../strategy/QuantEngine';
import { OrderIntent, LifecycleState } from '../models/types';
import { TradeResult, SimulationReport, MetricsEngine } from './MetricsEngine';

import { FakeBinanceExchange } from '../tests/FakeBinanceExchange';
import { FakeBinanceClient } from '../tests/FakeBinanceClient';
import { ExecutionEngine } from '../engine/ExecutionEngine';
import { IntentJournal } from '../db/IntentJournal';
import { RiskGuard } from '../engine/RiskGuard';
import { OrderTracker } from '../engine/OrderTracker';

export class HistoricalSimulator {
  private strategyEngine: StrategyEngine;
  private paEngine: PriceActionEngine;
  private msEngine: MicrostructureEngine;
  private quantEngine: QuantEngine;
  private metricsEngine: MetricsEngine;

  private exchange: FakeBinanceExchange;
  private client: FakeBinanceClient;
  private executionEngine: ExecutionEngine;
  private journal: IntentJournal;
  private riskGuard: RiskGuard;
  private tracker: OrderTracker;

  private trades: TradeResult[] = [];
  
  // Real-time states
  private activePA: PriceActionFeatures | null = null;
  private activeMS: MicrostructureFeatures | null = null;

  // Simulator config
  private initialCapital: number;
  private slippageBps: number;
  private feeBps: number;

  constructor(
    config: StrategyConfig,
    initialCapital: number = 10000,
    slippageBps: number = 1, // 0.01% standard slippage
    feeBps: number = 2 // 0.02% maker fee
  ) {
    this.strategyEngine = new StrategyEngine(config);
    this.paEngine = new PriceActionEngine();
    this.msEngine = new MicrostructureEngine(60000); // 1 minute rolling
    this.quantEngine = new QuantEngine({ feeRate: 0.0004, syntheticSlippage: 0.0001, minSamples: 0 });
    this.metricsEngine = new MetricsEngine();
    this.initialCapital = initialCapital;
    this.slippageBps = slippageBps;
    this.feeBps = feeBps;

    // Execution baseline wiring
    this.exchange = new FakeBinanceExchange();
    this.client = new FakeBinanceClient(this.exchange);
    this.journal = new IntentJournal(':memory:');
    this.riskGuard = new RiskGuard(this.journal, 10, 10, 100000);
    this.tracker = new OrderTracker(this.journal, this.riskGuard);
    this.executionEngine = new ExecutionEngine(this.client, this.journal);

    // Wire exchange to tracker
    this.exchange.on('message', (msg: string) => {
      this.tracker.handleTradeUpdate(JSON.parse(msg));
      this.extractFillsFromJournal();
    });
  }

  private extractFillsFromJournal() {
    // In a real system, the RiskGuard or Portfolio tracks PnL.
    // We poll the journal here to record Trades for MetricsEngine.
    // For simplicity, we just look at new FILLS since last check.
    const allIntents = this.journal.getAllIntents();
    for (const intent of allIntents) {
      if (intent.state === LifecycleState.CONFIRMED_FILLED) {
        // Did we record this trade yet?
        const exists = this.trades.find(t => t.clientOrderId === intent.clientOrderId);
        if (!exists) {
           // We extract the fill details. Since the journal doesn't store exact fee, we compute it.
           const fees = (intent.price * intent.originalQuantity) * (this.feeBps / 10000);
           const slippage = (intent.price * intent.originalQuantity) * (this.slippageBps / 10000);
           
           // Simplified PnL logic for grid: assuming matching pairs.
           // To be perfectly accurate, we should track average entry price, but for a grid, 
           // we assume each filled leg captures the gridSpacing if it has a pair.
           let pnl = 0;
           // If position is neutralising, we book gridSpacing profit.
           const position = this.riskGuard.getCurrentPosition();
           if ((intent.side === 'SELL' && position >= 0) || (intent.side === 'BUY' && position <= 0)) {
               pnl = (this.strategyEngine['config'].gridSpacing) * intent.originalQuantity;
           }

           const netPnl = pnl - fees - slippage;

           this.trades.push({
             clientOrderId: intent.clientOrderId,
             side: intent.side,
             entryPrice: intent.price,
             exitPrice: intent.price,
             quantity: intent.originalQuantity,
             pnl,
             fees,
             slippage,
             netPnl,
             entryTime: intent.createdAt,
             exitTime: Date.now(), // approximation
             regime: this.activePA?.marketStructure || 'NONE',
             featuresHash: `${this.activePA?.marketStructure}_${this.activeMS?.absorption}`
           });
        }
      }
    }
  }

  public async run(klines: Candle[], isOutofSample: boolean = false, featureMask?: { pa?: string[], ms?: string[] }): Promise<SimulationReport> {
    this.trades = [];

    for (const candle of klines) {
      // 1. Process Order Execution against this candle's price action BEFORE updating signals
      // This strictly enforces no-lookahead: old orders execute against new price.
      this.exchange.simulateCandle(candle, this.slippageBps, this.feeBps);

      // Wait a microtask to let events propagate through EventEmitter
      await new Promise(r => setImmediate(r));

      // 2. Update Price Action Engine
      this.activePA = this.paEngine.processCandle(candle);

      // 3. Update Microstructure Engine using strict available data.
      // We do not hallucinate intra-candle ticks if we don't have them.
      // All trade-level microstructure features (CVD, Imbalance, Absorption) and OI are unavailable
      // when running purely on klines.
      this.activeMS = {
        cvd: 'UNAVAILABLE_DUE_TO_DATA',
        takerImbalance: 'UNAVAILABLE_DUE_TO_DATA',
        oiDelta: 'UNAVAILABLE_DUE_TO_DATA',
        absorption: 'UNAVAILABLE_DUE_TO_DATA'
      };
      
      // 4. Quant Evaluate
      let evalPA = this.activePA;
      let evalMS = this.activeMS;

      if (featureMask) {
        if (evalPA && featureMask.pa) {
          evalPA = { ...evalPA };
          for (const key of featureMask.pa) {
            (evalPA as any)[key] = null;
          }
        }
        if (evalMS && featureMask.ms) {
          evalMS = { ...evalMS };
          for (const key of featureMask.ms) {
            (evalMS as any)[key] = null;
          }
        }
      }

      const score = this.quantEngine.evaluate(evalPA, evalMS);


      // 5. Check if we need to deploy a Grid
      // If we have no active working orders, maybe generate
      const activeIntents = this.journal.getAllIntents().filter(i => 
         i.state !== LifecycleState.CONFIRMED_FILLED && 
         i.state !== LifecycleState.CONFIRMED_CANCELED && 
         i.state !== LifecycleState.CONFIRMED_REJECTED
      );

      if (activeIntents.length === 0 && candle.isClosed) {
        const intents = this.strategyEngine.generateGrid(candle.close, evalPA, this.riskGuard.getCurrentPosition(), score);
        
        for (const intent of intents) {
          if (this.riskGuard.reserveAndSaveIntent(intent)) {
            await this.executionEngine.submitOrder(intent);
          }
        }
      }
    }

    return this.metricsEngine.calculateReport(this.trades, this.initialCapital);
  }
}
