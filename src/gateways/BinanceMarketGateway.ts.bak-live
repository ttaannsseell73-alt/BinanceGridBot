import WebSocket from 'ws';
import { EventEmitter } from 'events';
import { logger } from '../utils/logger';

export interface IMarketGateway extends EventEmitter {
  connect(): void;
  disconnect(): void;
  getCurrentPrice(): number;
}

export class BinanceMarketGateway extends EventEmitter implements IMarketGateway {
  private ws: WebSocket | null = null;
  private currentPrice: number = 0;

  constructor(private wsUrl: string, private symbol: string) {
    super();
  }

  public connect() {
    const url = `${this.wsUrl}/ws/${this.symbol.toLowerCase()}@bookTicker`;
    this.ws = new WebSocket(url);

    this.ws.on('open', () => {
      logger.info('MarketGateway connected');
    });

    this.ws.on('message', (data: WebSocket.Data) => {
      try {
        const payload = JSON.parse(data.toString());
        if (payload.b && payload.a) {
          // Mid price approximation
          const bid = parseFloat(payload.b);
          const ask = parseFloat(payload.a);
          this.currentPrice = (bid + ask) / 2;
          this.emit('price_update', this.currentPrice);
        }
      } catch (err) {
        logger.error({ err }, 'MarketGateway message parse error');
      }
    });

    this.ws.on('error', (err) => {
      logger.error({ err }, 'MarketGateway error');
    });

    this.ws.on('close', () => {
      logger.warn('MarketGateway closed. Reconnecting...');
      setTimeout(() => this.connect(), 5000);
    });
  }

  public disconnect() {
    if (this.ws) {
      this.ws.removeAllListeners();
      this.ws.close();
      this.ws = null;
    }
  }

  public getCurrentPrice(): number {
    return this.currentPrice;
  }
}
