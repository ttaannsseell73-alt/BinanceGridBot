NODE_ENV=development
LOG_LEVEL=debug

# Binance API Credentials
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# Binance Futures Testnet Endpoints
BINANCE_FUTURES_URL=https://testnet.binancefuture.com
BINANCE_FUTURES_WS_URL=wss://stream.binancefuture.com

# Target Symbol
SYMBOL=BTCUSDT

# Risk Limits (Base asset, e.g., BTC quantities)
MAX_LONG_EXPOSURE=1.0
MAX_SHORT_EXPOSURE=1.0
MAX_TOTAL_NOTIONAL=100000

# SQLite
DB_PATH=./data/bot.db

# Fail-closed production acknowledgement.
# Keep unset/NO for Testnet. Required as exactly "yes" for non-testnet endpoints.
I_UNDERSTAND_LIVE=NO

# Manual emergency-halt recovery. Set to yes only after investigation.
ACKNOWLEDGE_CLEAR_HALT=NO
